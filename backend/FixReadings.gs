function fixPlain_(s) {
  return String(s || '').replace(/\{([^|}]+)\|[^}]+\}/g, '$1');
}

function fixText_(s) {
  let t = String(s);
  FIX_PAIRS.forEach(function (p) { t = t.split(p[0]).join(p[1]); });
  return t;
}

function fixReadings() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let qFixed = 0, expRestored = 0, vFixed = 0;
  const stillEmpty = [];

  // 1・2. Questions（D列から: 問題形式=D, 本文=E, 問題文=G, 選択肢=H〜K, 解説=M）
  const qs = ss.getSheetByName(SHEET_QUESTIONS);
  const qLast = qs.getLastRow();
  if (qLast > 1) {
    const range = qs.getRange(2, 1, qLast - 1, 13);
    const values = range.getValues();
    const touched = [];
    values.forEach(function (r, i) {
      if (!r[0]) return;
      let changed = false;
      [4, 6, 7, 8, 9, 10, 12].forEach(function (c) {
        if (typeof r[c] !== 'string' || !r[c]) return;
        const t = fixText_(r[c]);
        if (t !== r[c]) { r[c] = t; changed = true; }
      });
      if (!String(r[12] || '').trim()) {
        const key = String(r[1]) + '|' + String(r[3]) + '|' + fixPlain_(r[6]) + '|' + fixPlain_(r[4]).slice(0, 40);
        if (FIX_EXPLANATIONS[key]) {
          r[12] = FIX_EXPLANATIONS[key];
          changed = true;
          expRestored++;
        } else {
          stillEmpty.push(r[0] + '（' + r[1] + ' ' + r[3] + '）');
        }
      }
      if (changed) { qFixed++; touched.push(i); }
    });
    // 変わった行だけ書き戻す（ほかの行の書式・日時はそのまま）
    touched.forEach(function (i) {
      const r = values[i];
      qs.getRange(i + 2, 5).setValue(r[4]);
      qs.getRange(i + 2, 7, 1, 5).setValues([[r[6], r[7], r[8], r[9], r[10]]]);
      qs.getRange(i + 2, 13).setValue(r[12]);
    });
  }

  // 1. Vocab（例文=F列）
  const vs = ss.getSheetByName(SHEET_VOCAB);
  const vLast = vs ? vs.getLastRow() : 0;
  if (vLast > 1) {
    const vr = vs.getRange(2, 6, vLast - 1, 1);
    const vv = vr.getValues();
    vv.forEach(function (r, i) {
      if (typeof r[0] !== 'string' || !r[0]) return;
      const t = fixText_(r[0]);
      if (t !== r[0]) { vs.getRange(i + 2, 6).setValue(t); vFixed++; }
    });
  }

  // 3. キャッシュを作り直す
  bumpDataVersion_();

  Logger.log('問題：' + qFixed + '件を直しました（そのうち、解説を戻した問題：' + expRestored + '件）');
  Logger.log('単語カード：' + vFixed + '件の例文を直しました');
  if (stillEmpty.length) {
    Logger.log('解説が空のままの問題：' + stillEmpty.length + '件（もとの解説がこちらにないもの）');
    Logger.log(stillEmpty.slice(0, 50).join('\n'));
  } else {
    Logger.log('解説が空の問題はありません');
  }
}
